{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.5.0",
  "description": "__MSG_extDesc__",
  "default_locale": "ko",
  "key": "",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "sw/main.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aliexpress.com/p/order/*",
        "https://*.aliexpress.com/p/tracking/*",
        "https://*.aliexpress.us/p/order/*",
        "https://trade.aliexpress.com/*"
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.aliexpress.com/p/order/*",
        "https://*.aliexpress.com/p/tracking/*",
        "https://*.aliexpress.us/p/order/*",
        "https://trade.aliexpress.com/*"
      ],
      "js": [
        "lib/core.js",
        "lib/extract.js",
        "lib/stats.js",
        "content/base.js",
        "content/format.js",
        "content/health.js",
        "content/collect.js",
        "content/fast.js",
        "content/details.js",
        "content/detail-auto.js",
        "content/ui.js",
        "content/export.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}